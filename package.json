{
  "name": "extrovert",
  "version": "0.1.2",
  "private": true,
  "description": "All your communities. One space.",
  "author": "Pantho Haque",
  "homepage": "https://pantho-haque.github.io/Extrovert",
  "repository": "github:Pantho-Haque/Extrovert",
  "license": "MIT",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "bash tests/e2e/run.sh",
    "dist": "electron-vite build && electron-builder --publish never",
    "icons": "electron scripts/make-icons.cjs",
    "sync-docs": "UPDATE_DOCS=1 vitest run src/core/guide"
  },
  "devDependencies": {
    "@tabler/icons-react": "^3.49.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
